# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string (Neon). Use the *pooled* connection string
# (hostname contains "-pooler"). See INSTALL.md section "Database setup".
DATABASE_URL=

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different value in production than locally.
AUTH_SECRET=

# Full URL to this app's auth routes — must end in /api/auth (that's where
# this app mounts them). Locally this is your dev server URL + /api/auth;
# in production, your real domain + /api/auth.
AUTH_URL=http://localhost:4000/api/auth

# LocationIQ API key, used by the pickup/delivery address autocomplete.
# Sign up free at https://locationiq.com (no card required). Exposed to the
# browser on purpose — see docs/TECHNICAL_DOCUMENTATION.md, section on
# environment variables, for why that's safe.
NEXT_PUBLIC_LOCATIONIQ_API_KEY=
